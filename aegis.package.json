{
  "name": "aegis",
  "version": "0.1.0",
  "description": "The security platform for AI agents. Scan MCP servers, agent code and runtime behaviour; evolutionary red teaming; behavioural fingerprinting; self-healing remediation; living attack graph.",
  "license": "MIT",
  "type": "module",
  "author": "Aegis Security",
  "homepage": "https://aegis.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aegis-security/aegis.git"
  },
  "bugs": {
    "url": "https://github.com/aegis-security/aegis/issues"
  },
  "keywords": [
    "ai-security",
    "agent-security",
    "mcp",
    "model-context-protocol",
    "prompt-injection",
    "llm-security",
    "sast",
    "red-team",
    "owasp-agentic",
    "sarif",
    "security-scanner"
  ],
  "bin": {
    "aegis": "./build/publish/packages/cli/src/bin.js"
  },
  "main": "./build/publish/packages/core/src/index.js",
  "types": "./build/publish/packages/core/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/publish/packages/core/src/index.d.ts",
      "import": "./build/publish/packages/core/src/index.js"
    },
    "./core": {
      "types": "./build/publish/packages/core/src/index.d.ts",
      "import": "./build/publish/packages/core/src/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build/publish/**",
    "packages/rules/**",
    "packages/web/public/**",
    "packages/core/test/fixtures/**",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "test": "node scripts/run-tests.mts all",
    "smoke": "node --import ./tools/register-ts.mjs scripts/smoke.mts"
  },
  "dependencies": {},
  "devDependencies": {},
  "publishConfig": {
    "access": "public"
  }
}