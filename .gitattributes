# Normalise line endings.
#
# Every source file is LF. Windows' default checkout converts to CRLF, which
# corrupts files mid-edit and broke template literals and regex literals more
# than once during development. This is not cosmetic.

* text=auto eol=lf

*.ts    text eol=lf
*.mts   text eol=lf
*.mjs   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.yaml  text eol=lf
*.yml   text eol=lf
*.md    text eol=lf
*.mdx   text eol=lf
*.css   text eol=lf
*.html  text eol=lf
*.py    text eol=lf
*.sh    text eol=lf

# Binary assets must never be line-ending converted.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.pdf   binary
*.woff  binary
*.woff2 binary

# Generated output is not source.
.aegis/       text eol=lf
*.sarif        text eol=lf
dist/         -text
node_modules/ -text
