# Aegis Staging Environment Configuration
#
# Copy this file to .env.staging and fill in the values.
# DO NOT commit this file with real values.

# ---- Aegis core ----
NODE_ENV=staging
LOG_LEVEL=info

# Local/dev database (use managed PostgreSQL in staging)
DATABASE_URL=postgresql://aegis_staging:changeme@staging-db.example.com:5432/aegis_staging
REDIS_URL=redis://staging-redis.example.com:6379

# ---- Aegis hosted dashboard (packages/web) ----
NEXT_PUBLIC_APP_URL=https://staging.aegis.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_staging_replace_me
CLERK_SECRET_KEY=sk_test_staging_replace_me

# ---- Payments (use test keys) ----
STRIPE_SECRET_KEY=sk_test_staging_replace_me
STRIPE_WEBHOOK_SECRET=whsec_staging_replace_me
STRIPE_PRO_PRICE_ID=price_staging_pro
STRIPE_TEAM_PRICE_ID=price_staging_team
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://staging-store.lemonsqueezy.com/checkout/buy/xxxx
LEMON_SQUEEZY_API_KEY=staging_replace_me
PADDLE_CLIENT_TOKEN=staging_replace_me
PADDLE_VENDOR_ID=staging_replace_me
PADDLE_API_KEY=staging_replace_me

# ---- Observability ----
NEXT_PUBLIC_POSTHOG_KEY=phc_staging_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=https://staging-sentry.example.com/123

# ---- BYOK LLM keys (used by aegis redteam / aegis fix) ----
# Use staging/rate-limited keys
OPENAI_API_KEY=sk-staging-replace-me
ANTHROPIC_API_KEY=sk-ant-staging-replace-me
GOOGLE_API_KEY=AIza-staging-replace-me
OLLAMA_HOST=http://staging-ollama.example.com:11434

# ---- Red teaming ----
AEGIS_API_KEY=staging-api-key
AEGIS_API_URL=https://staging-api.aegis.example.com
AEGIS_TELEMETRY=0

# ---- Dashboard auth (set for staging exposure) ----
AEGIS_DASHBOARD_TOKEN=staging-dashboard-token-replace-me

# ---- Observability (staging) ----
AEGIS_OBSERVABILITY_SERVICE_NAME=aegis-staging
AEGIS_OBSERVABILITY_ENABLE_METRICS=1
AEGIS_OBSERVABILITY_ENABLE_TRACING=1
AEGIS_OBSERVABILITY_LOG_LEVEL=info
AEGIS_OBSERVABILITY_PROMETHEUS_PORT=9464