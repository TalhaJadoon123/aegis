# Paths Aegis should not scan.
#
# `.gitignore` is also honoured; this file exists for paths you want Aegis to
# skip but that git should still track -- generated reports, sandbox workspaces,
# and scratch output.

# Demos are deliberately insecure and exist to be found. Scanning them makes
# the tool's own output useless in a demo.
demos/
docs/

# Test fixtures are intentionally vulnerable. The test suite asserts on them;
# a scan of the repo does not need to re-report them.
packages/core/test/fixtures/
packages/rules/.aegisignore

# Aegis's own attack corpus.
#
# These files exist to *contain* attack strings: the rule definitions that
# detect them, the templates the red teamer mutates, the seed graph, and the
# synthetic credentials the tests inject. Flagging them is a true positive
# about the file and a false positive about the system, and a scanner whose own
# corpus lights up red is one nobody will act on.
#
# Scanned explicitly with:
#   aegis scan packages/core/src/redteam --rule-dir packages/rules/rules
packages/core/src/redteam/
packages/core/src/intel/seed.ts
packages/core/scripts/demo-redteam.mts
packages/core/test/synthetic-secrets.ts

# Generated artefacts
*.sarif
aegis-report.*
aegis-supply-chain.html
sandbox-output/
