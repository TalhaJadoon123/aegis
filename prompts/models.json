{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "version": "1.0.0",
  "description": "Aegis Model Configuration - LLM provider configurations for red team and fix commands",
  "providers": {
    "openai": {
      "name": "OpenAI",
      "baseUrl": "https://api.openai.com/v1",
      "models": {
        "gpt-4o": {
          "name": "GPT-4o",
          "maxTokens": 128000,
          "costPer1kInputTokens": 0.005,
          "costPer1kOutputTokens": 0.015,
          "supportsTools": true,
          "supportsVision": true,
          "supportsJsonMode": true
        },
        "gpt-4o-mini": {
          "name": "GPT-4o Mini",
          "maxTokens": 128000,
          "costPer1kInputTokens": 0.00015,
          "costPer1kOutputTokens": 0.0006,
          "supportsTools": true,
          "supportsVision": true,
          "supportsJsonMode": true
        },
        "gpt-4-turbo": {
          "name": "GPT-4 Turbo",
          "maxTokens": 128000,
          "costPer1kInputTokens": 0.01,
          "costPer1kOutputTokens": 0.03,
          "supportsTools": true,
          "supportsVision": true,
          "supportsJsonMode": true
        },
        "gpt-3.5-turbo": {
          "name": "GPT-3.5 Turbo",
          "maxTokens": 16385,
          "costPer1kInputTokens": 0.0005,
          "costPer1kOutputTokens": 0.0015,
          "supportsTools": true,
          "supportsJsonMode": true
        }
      },
      "auth": {
        "type": "bearer",
        "header": "Authorization",
        "envVar": "OPENAI_API_KEY"
      },
      "rateLimits": {
        "requestsPerMinute": 500,
        "tokensPerMinute": 200000
      }
    },
    "anthropic": {
      "name": "Anthropic",
      "baseUrl": "https://api.anthropic.com/v1",
      "models": {
        "claude-3-5-sonnet-20241022": {
          "name": "Claude 3.5 Sonnet",
          "maxTokens": 200000,
          "costPer1kInputTokens": 0.003,
          "costPer1kOutputTokens": 0.015,
          "supportsTools": true,
          "supportsVision": true
        },
        "claude-3-opus-20240229": {
          "name": "Claude 3 Opus",
          "maxTokens": 200000,
          "costPer1kInputTokens": 0.015,
          "costPer1kOutputTokens": 0.075,
          "supportsTools": true,
          "supportsVision": true
        },
        "claude-3-haiku-20240307": {
          "name": "Claude 3 Haiku",
          "maxTokens": 200000,
          "costPer1kInputTokens": 0.00025,
          "costPer1kOutputTokens": 0.00125,
          "supportsTools": true,
          "supportsVision": true
        }
      },
      "auth": {
        "type": "bearer",
        "header": "x-api-key",
        "envVar": "ANTHROPIC_API_KEY"
      },
      "rateLimits": {
        "requestsPerMinute": 50,
        "tokensPerMinute": 40000
      }
    },
    "google": {
      "name": "Google AI",
      "baseUrl": "https://generativelanguage.googleapis.com/v1beta",
      "models": {
        "gemini-1.5-pro": {
          "name": "Gemini 1.5 Pro",
          "maxTokens": 2000000,
          "costPer1kInputTokens": 0.0035,
          "costPer1kOutputTokens": 0.0105,
          "supportsTools": true,
          "supportsVision": true
        },
        "gemini-1.5-flash": {
          "name": "Gemini 1.5 Flash",
          "maxTokens": 1000000,
          "costPer1kInputTokens": 0.000075,
          "costPer1kOutputTokens": 0.0003,
          "supportsTools": true,
          "supportsVision": true
        }
      },
      "auth": {
        "type": "bearer",
        "header": "Authorization",
        "envVar": "GOOGLE_API_KEY"
      },
      "rateLimits": {
        "requestsPerMinute": 60,
        "tokensPerMinute": 250000
      }
    },
    "ollama": {
      "name": "Ollama (Local)",
      "baseUrl": "http://localhost:11434",
      "models": {
        "llama3.1:8b": {
          "name": "Llama 3.1 8B",
          "maxTokens": 131072,
          "costPer1kInputTokens": 0,
          "costPer1kOutputTokens": 0,
          "supportsTools": false
        },
        "llama3.1:70b": {
          "name": "Llama 3.1 70B",
          "maxTokens": 131072,
          "costPer1kInputTokens": 0,
          "costPer1kOutputTokens": 0,
          "supportsTools": false
        },
        "mistral:7b": {
          "name": "Mistral 7B",
          "maxTokens": 32768,
          "costPer1kInputTokens": 0,
          "costPer1kOutputTokens": 0,
          "supportsTools": false
        },
        "codellama:13b": {
          "name": "CodeLlama 13B",
          "maxTokens": 16384,
          "costPer1kInputTokens": 0,
          "costPer1kOutputTokens": 0,
          "supportsTools": false
        }
      },
      "auth": {
        "type": "none"
      },
      "rateLimits": {
        "requestsPerMinute": 1000,
        "tokensPerMinute": 1000000
      }
    }
  },
  "defaults": {
    "redteam": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "temperature": 0.7,
      "maxTokens": 2048,
      "timeoutMs": 30000
    },
    "fix": {
      "provider": "openai",
      "model": "gpt-4o",
      "temperature": 0.1,
      "maxTokens": 4096,
      "timeoutMs": 60000
    },
    "scan": {
      "provider": "openai",
      "model": "gpt-4o-mini",
      "temperature": 0,
      "maxTokens": 2048,
      "timeoutMs": 30000
    }
  },
  "costBudgets": {
    "redteam": {
      "defaultBudgetUsd": 10.00,
      "maxBudgetUsd": 100.00,
      "warningThreshold": 0.8
    },
    "fix": {
      "defaultBudgetUsd": 5.00,
      "maxBudgetUsd": 50.00,
      "warningThreshold": 0.8
    }
  }
}