# Aegis Production Environment Configuration
#
# Copy this file to .env.production and fill in the values.
# DO NOT commit this file with real values.
# Use a secret manager (1Password, AWS Secrets Manager, HashiCorp Vault) in production.

# ---- Aegis core ----
NODE_ENV=production
LOG_LEVEL=info

# Production database (use managed PostgreSQL with SSL)
DATABASE_URL=postgresql://aegis_prod:changeme@prod-db.example.com:5432/aegis_prod?sslmode=require
REDIS_URL=redis://prod-redis.example.com:6379

# ---- Aegis hosted dashboard (packages/web) ----
NEXT_PUBLIC_APP_URL=https://aegis.example.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_live_replace_me
CLERK_SECRET_KEY=sk_live_replace_me

# ---- Payments (use live keys) ----
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_live_replace_me
STRIPE_PRO_PRICE_ID=price_live_pro
STRIPE_TEAM_PRICE_ID=price_live_team
NEXT_PUBLIC_LEMON_SQUEEZY_CHECKOUT_URL=https://aegis.lemonsqueezy.com/checkout/buy/xxxx
LEMON_SQUEEZY_API_KEY=live_replace_me
PADDLE_CLIENT_TOKEN=live_replace_me
PADDLE_VENDOR_ID=live_replace_me
PADDLE_API_KEY=live_replace_me

# ---- Observability ----
NEXT_PUBLIC_POSTHOG_KEY=phc_live_replace_me
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
SENTRY_DSN=https://prod-sentry.example.com/123

# ---- BYOK LLM keys (used by aegis redteam / aegis fix) ----
# Use production keys with appropriate rate limits
OPENAI_API_KEY=sk-live-replace-me
ANTHROPIC_API_KEY=sk-ant-live-replace-me
GOOGLE_API_KEY=AIza-live-replace-me
OLLAMA_HOST=https://ollama.example.com:11434

# ---- Red teaming ----
AEGIS_API_KEY=prod-api-key
AEGIS_API_URL=https://api.aegis.example.com
AEGIS_TELEMETRY=0

# ---- Dashboard auth (REQUIRED for production exposure) ----
AEGIS_DASHBOARD_TOKEN=prod-dashboard-token-replace-me

# ---- Observability (production) ----
AEGIS_OBSERVABILITY_SERVICE_NAME=aegis-prod
AEGIS_OBSERVABILITY_ENABLE_METRICS=1
AEGIS_OBSERVABILITY_ENABLE_TRACING=1
AEGIS_OBSERVABILITY_LOG_LEVEL=info
AEGIS_OBSERVABILITY_PROMETHEUS_PORT=9464
AEGIS_OBSERVABILITY_OTLP_ENDPOINT=https://otel-collector.example.com:4318