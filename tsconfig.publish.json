{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "outDir": "build/publish",
    "declaration": true,
    "declarationMap": false,
    "sourceMap": false,
    "removeComments": false,
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"]
  },
  "include": [
    "packages/core/src/**/*.ts",
    "packages/cli/src/**/*.ts",
    "packages/web/src/**/*.ts",
    "packages/intel-feeds/src/**/*.ts"
  ],
  "exclude": [
    "**/test/**",
    "**/*.test.ts",
    "**/node_modules/**"
  ]
}